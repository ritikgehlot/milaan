# Copy to .env and fill in. Never commit .env.

# --- LLM: any OpenAI-compatible endpoint (Gemini shown; free key at aistudio.google.com) ---
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash   # gemini-2.5-flash is no longer offered to new keys; agent.check lists what yours can use
# LLM_VISION_MODEL=        # optional, defaults to LLM_MODEL
# --- OR use Claude instead of Gemini: ---
# LLM_API_KEY=sk-ant-...
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-sonnet-5-5
# GEMINI_API_KEY=          # only if LLM is not Gemini but you want voice notes via Gemini

# --- Twilio WhatsApp sandbox (console.twilio.com > Messaging > Try it out > WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # trial flow shows another number, e.g. whatsapp:+17372212163
TWILIO_VALIDATE_SIGNATURE=1

# --- OPTIONAL: second Twilio trial (teammate's account) for the SUPPLIER phone only.
# Needed if your trial allows only one active WhatsApp recipient.
# SUPPLIER_TWILIO_ACCOUNT_SID=
# SUPPLIER_TWILIO_AUTH_TOKEN=
# SUPPLIER_TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX

# --- OR: Meta WhatsApp Cloud API instead of Twilio (see SETUP_AGENT.md, section 3b) ---
# twilio (default) or meta. The server reads this at start, so restart it after changing .env.
WHATSAPP_PROVIDER=twilio
# Meta app > WhatsApp > API Setup: temporary access token (expires in ~24 h) and "Phone number ID"
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# the version in the sample curl on that page, e.g. v22.0 (copy it, don't guess)
META_API_VERSION=
# Meta app > App settings > Basic > App secret (verifies incoming webhooks)
META_APP_SECRET=
# any long random string you choose; type the same value into the Meta webhook settings
META_VERIFY_TOKEN=

# --- your tunnel's https URL (cloudflared or ngrok), no trailing slash ---
PUBLIC_URL=

# --- who is the trader (comma-separated, with country code) ---
TRADER_PHONES=+91XXXXXXXXXX

# --- dashboard: open http://localhost:5050/dashboard on the laptop.
# To open it through the tunnel (e.g. on a judge's phone): <PUBLIC_URL>/dashboard?t=<token>
DASHBOARD_TOKEN=

# --- behaviour ---
MAX_CHASES=3
CHASE_INTERVAL_DAYS=7
DEMO_COMMANDS=1
