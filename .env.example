# MILAAN Environment Variables
# Copy this file to .env for your own reference, then export the variables
# in your shell before starting the app. MILAAN does NOT load .env files
# automatically. Never commit real credentials.

APP_ENV=development
DATABASE_PATH=milaan.db
PORT=8501

# Production access control. APP_ENV=production enables OIDC sign-in by
# default. Configure provider secrets only in .streamlit/secrets.toml; use
# .streamlit/secrets.example.toml as the non-secret template.
MILAAN_AUTH_REQUIRED=false
# Optional comma-separated OIDC email-domain allowlist, e.g. example.com
MILAAN_ALLOWED_EMAIL_DOMAINS=

# WhatsApp Cloud API (Task 7). Real delivery is DISABLED by default.
# Leave WHATSAPP_ENABLED unset/false for simulated-only use.
# Use the exact API version and phone-number ID shown in your Meta app;
# do not guess an API version. The access token must never be committed,
# logged, pasted into the UI, or written to SQLite.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
# Optional: finite manual-retry budget per delivery record (default 3,
# maximum 5). There is no background retry scheduler.
WHATSAPP_MAX_ATTEMPTS=3
